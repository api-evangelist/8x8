                      "responseTime": null,
                      "body": "{\n  \"examples\": {\n    \"response\": {\n      \"value\": {\n        \"prevCursor\": \"5775\",\n        \"list\": [\n          {\n            \"CallId\": \"5774\",\n            \"UserB_MSISDN\": \"639215074178\",\n            \"CreatedAt\": \"2019-02-05T07:19:28.850Z\",\n            \"FinishedAt\": \"2019-02-05T07:24:50.170Z\",\n            \"Duration\": 25,\n            \"Status\": \"E\",\n            \"CountryISO2alpha\": \"PH\",\n            \"Reference\": \"ffdsfsfsf\"\n          },\n          {\n            \"CallId\": \"5756\",\n            \"UserB_MSISDN\": \"null,\",\n            \"CreatedAt\": \"2019-02-04T04:00:26.250Z\",\n            \"Duration\": 0,\n            \"Status\": \"C\",\n            \"CountryISO2alpha\": \"\u201cSG\u201d\",\n            \"Reference\": \"mdopyomn\"\n          }\n        ]\n      }\n    }\n  }\n}",
