            {
              "name": "call-logs",
              "item": [
                {
                  "name": "Call Logs",
                  "id": "04085ee9-50d5-429e-89e1-61272bb584d4",
                  "protocolProfileBehavior": {
                    "disableBodyPruning": true
                  },
                  "request": {
                    "method": "GET",
                    "header": [
                      {
                        "description": "(Required) ",
                        "key": "x-token",
                        "value": "{YourAuthToken}"
                      },
                      {
                        "key": "Accept",
                        "value": "application/json"
                      }
                    ],
                    "url": {
                      "raw": "{{baseUrl}}/api/v1/call-logs?from= yyyy-mm-dd&to= yyyy-mm-dd&q=<string>&cursor=<string>",
                      "host": [
                        "{{baseUrl}}"
                      ],
                      "path": [
                        "api",
                        "v1",
                        "call-logs"
                      ],
                      "query": [
                        {
                          "key": "from",
                          "value": " yyyy-mm-dd"
                        },
                        {
                          "key": "to",
                          "value": " yyyy-mm-dd"
                        },
                        {
                          "key": "q",
                          "value": "<string>"
                        },
                        {
                          "key": "cursor",
                          "value": "<string>"
                        }
                      ]
                    },
                    "description": "This API endpoint allows to retrieve information related to past calls. You need to use the Token API first to create an Authorization Token. You can to list the calls during a time period or with a specific Call_Reference or Phone_Number. \n\nExample 1: \n```\ncurl -X POST https://video-agent.8x8.com//api/v1/call-logs \\\n-H \"Content-Type: application/json\" \\\n-H x-token: YourAuthToken' \\\n```\n\nExample 2:\n```\ncurl -X POST\nhttps://video-agent.8x8.com/api/v1/call-logs?from=yyyy-mm-dd&to=yyyy-mm-dd&q=12345&cursor=5757 \\\n-H \"Content-Type: application/json\" \\\n-H x-token: YourAuthToken' \\\n```\n"
                  },
                  "response": [
                    {
                      "id": "af3146f9-a120-4e73-a453-0666e92cf574",
                      "name": "New Response",
                      "originalRequest": {
                        "method": "GET",
                        "header": [
                          {
                            "description": "(Required) ",
                            "key": "x-token",
                            "value": "{YourAuthToken}"
                          },
                          {
                            "key": "Accept",
                            "value": "application/json"
                          }
                        ],
                        "url": {
                          "raw": "{{baseUrl}}/api/v1/call-logs?from= yyyy-mm-dd&to= yyyy-mm-dd&q=<string>&cursor=<string>",
                          "host": [
                            "{{baseUrl}}"
                          ],
                          "path": [
                            "api",
                            "v1",
                            "call-logs"
                          ],
                          "query": [
                            {
                              "key": "from",
                              "value": " yyyy-mm-dd"
                            },
                            {
                              "key": "to",
                              "value": " yyyy-mm-dd"
                            },
                            {
                              "key": "q",
                              "value": "<string>"
                            },
                            {
                              "key": "cursor",
                              "value": "<string>"
                            }
                          ]
                        }
