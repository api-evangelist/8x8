              {
                "name": "contactId",
                "value": "",
                "type": "path",
                "description": "Contact Id"
              }
            ]
          },
          "docs": "Get contact information by contact id"
        },
        {
          "info": {
            "name": "Update contact information",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://contacts.8x8.com/api/v1/accounts/:accountId/contacts/:contactId",
            "params": [
              {
                "name": "contactId",
                "value": "",
                "type": "path",
                "description": "Contact Id"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update contact information"
        },
        {
          "info": {
            "name": "Delete single contact",
            "type": "http"
