{
  "opencollection": "1.0.0",
  "info": {
    "name": "Contacts API",
    "version": "1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Contacts API",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Search contacts",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://contacts.8x8.com/api/v1/accounts/:accountId/contacts",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Number of items to include in the response"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Page offset. Setting limit to 10 and offset to 0 returns the first 10 items. Increment offset to retrieve more items."
              },
              {
                "name": "query",
                "value": "",
                "type": "query",
                "description": "Some arbitrary string to search for. Can be name or one of addresses (email, phone number, etc)"
              },
              {
                "name": "groupId",
                "value": "",
                "type": "query",
                "description": "Search contacts in a particular group"
              },
              {
                "name": "country",
                "value": "",
                "type": "query",
                "description": "To search for a contact or contacts using country, please use Alpha-2 country code ([two character country codes](https://www.iban.com/country-codes))"
              }
            ]
          },
          "docs": "Search for contacts"
        },
        {
          "info": {
            "name": "Create contact",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://contacts.8x8.com/api/v1/accounts/:accountId/contacts",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new contact"
        },
        {
          "info": {
            "name": "Blacklist msisdn for a specific account",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://contacts.8x8.com/api/v1/accounts/:accountId/contacts/blacklist/:msisdn",
            "params": [
              {
                "name": "msisdn",
                "value": "6512345678",
                "type": "path",
                "description": "Msisdn to blacklist"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Blacklist msisdn for a specific account"
        },
        {
          "info": {
            "name": "Get contact information by id",
