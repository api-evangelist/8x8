          "http": {
            "method": "DELETE",
            "url": "https://contacts.8x8.com/api/v1/accounts/:accountId/contacts/:contactId",
            "params": [
              {
                "name": "contactId",
                "value": "",
                "type": "path",
                "description": "Contact Id"
              }
            ]
          },
          "docs": "Delete single contact by id"
        }
      ]
