    {
      "info": {
        "name": "Batch API",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Batch create contacts",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://contacts.8x8.com/api/v1/accounts/:accountId/contacts/batches/createContacts",
            "body": {
              "type": "multipart-form",
              "data": []
            }
          },
          "docs": "Batch create contacts using file. The file can be either CSV or Excel. The CSV file can contain a header row (the mapping of the columns will be automatic in this case), or not. For files without a header, the `fileColumns` property should be specified for a columns mapping."
        },
        {
          "info": {
            "name": "Batch delete contacts",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://contacts.8x8.com/api/v1/accounts/:accountId/contacts/batches/deleteContacts",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Use this endpoint to delete multiple/all contacts in batch. Provide `ids` or `msisdns` to remove specific contacts, or set `\"all\": true` to delete all contacts in your account."
        },
        {
          "info": {
            "name": "Copy contacts between groups",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://contacts.8x8.com/api/v1/accounts/:accountId/groups/batches/copyContacts",
            "params": [
              {
                "name": "from",
                "value": "",
                "type": "query",
                "description": "Identifier of the source group"
              },
              {
                "name": "to",
                "value": "",
                "type": "query",
                "description": "Identifier of the destination group"
              }
            ]
          },
          "docs": "Copy contacts from ony group to another one."
        },
        {
          "info": {
            "name": "Move contacts between groups",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://contacts.8x8.com/api/v1/accounts/:accountId/groups/batches/moveContacts",
            "params": [
              {
                "name": "from",
                "value": "",
                "type": "query",
                "description": "Identifier of the source group"
              },
              {
                "name": "to",
                "value": "",
                "type": "query",
                "description": "Identifier of the destination group"
              }
            ]
          },
          "docs": "Move contacts from one group to another one. This operation will delete contacts in the original group."
        },
        {
          "info": {
            "name": "Batch delete groups",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://contacts.8x8.com/api/v1/accounts/:accountId/groups/batches/deleteGroups",
