        {
          "id": "0ee66c12-3bc8-4d34-83aa-d09fc92515dd",
          "name": "Add records to campaign",
          "request": {
            "name": "Add records to campaign",
            "description": {
              "content": "Add one or more records (1-100) to a dynamic campaign. Records are validated, CRM data is queried, and phone numbers are checked against DNC lists. Operation is atomic - all records succeed or all fail.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                ":campaignId",
                "records"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>",
                  "key": "campaignId",
                  "description": "(Required) Campaign UUID"
                },
                {
                  "description": "Your Contact Center site identifier",
                  "type": "any",
                  "value": "{{customer-site}}",
                  "key": "customer-site"
                }
              ]
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) Admin Console API Key with the **Contact Center Campaigns** API Product attached. Always starts with `eght_`.",
                "key": "x-api-key",
                "value": "<string>"
              },
              {
                "disabled": false,
                "description": "(Required) Tenant identifier",
                "key": "X-8x8-Tenant",
                "value": "<string>"
              },
              {
                "key": "Content-Type",
                "value": "application/vnd.campaigns.v1+json"
              },
              {
                "key": "Accept",
                "value": "application/vnd.campaigns.v1+json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"records\": [\n    {\n      \"crmRecordId\": \"<string>\",\n      \"scheduleAt\": \"<dateTime>\",\n      \"priority\": \"<string>\",\n      \"rank\": \"<double>\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
