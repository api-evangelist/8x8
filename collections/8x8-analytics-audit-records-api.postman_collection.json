          "request": {
            "name": "Get audit records.",
            "description": {
              "content": "Retrieve audit records in JSON format",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "audits"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "size",
                  "value": "<integer>",
                  "description": "Maximum number of items per page. It must be greater than zero. Default value is 20, maximum is 100."
                },
                {
                  "disabled": false,
                  "key": "startTime",
                  "value": "<string>",
                  "description": "(Required) Start time for audit records (ISO 8601 format), it should be maximum of 31 days before end time."
                },
                {
                  "disabled": false,
                  "key": "endTime",
                  "value": "<string>",
                  "description": "(Required) End time of audit records (ISO 8601 format)."
                },
                {
                  "disabled": false,
                  "key": "service",
                  "value": "<string>",
                  "description": "(Required) Name of a service that generated audit records."
                },
                {
                  "disabled": false,
                  "key": "displayName",
                  "value": "<string>",
                  "description": "Name linked with entity i.e, if an entity is user it's userName, if an entity is RingGroup it is a ring group name."
                },
                {
                  "disabled": false,
                  "key": "auditUserId",
                  "value": "<string>",
                  "description": "The identifier for user who performed audit action."
                },
                {
                  "disabled": false,
                  "key": "entityTypes",
                  "value": "<string>",
                  "description": "Comma-separated strings of entity types."
                },
                {
                  "disabled": false,
                  "key": "eventTypes",
                  "value": "<string>",
                  "description": "Comma-separated strings of event types."
                },
                {
                  "disabled": false,
                  "key": "scrollId",
                  "value": "<string>",
                  "description": "The scrollId parameter returned from your previous call. You can include this parameter in your next or subsequent calls to retrieve the next page of records. To retrieve first page no need to provide scrollId."
                }
              ],
              "variable": []
            },
