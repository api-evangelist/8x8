        {
          "info": {
            "name": "Deletes a single interaction.",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.8x8.com/qm/{region}/{apiversion}/interactions/:interactionGuid",
            "params": [
              {
                "name": "interactionGuid",
                "value": "",
                "type": "path",
                "description": "The interaction unique identifier."
              }
            ]
          },
          "docs": "Removes the interaction and all associated metadata. This action cannot be undone."
        },
        {
          "info": {
            "name": "This method purges a single interaction.",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.8x8.com/qm/{region}/{apiversion}/interactions/:interactionGuid/purge",
