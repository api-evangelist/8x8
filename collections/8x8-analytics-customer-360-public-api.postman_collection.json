          "name": "Get transcript summaries",
          "request": {
            "name": "Get transcript summaries",
            "description": {
              "content": "Retrieves transcript summaries for one or more interaction IDs.\n\nPass one or more `interactionId` query parameters. The API returns successfully retrieved summaries and lists any IDs that could not be retrieved as partial failures.\n\nA maximum of 50 interaction IDs can be provided per request.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "public",
                "tenants",
                ":tenantId",
                "transcript-summaries"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "interactionId",
                  "value": "<string>",
                  "description": "(Required) One or more interaction IDs. Repeat the parameter for batch retrieval (e.g. ?interactionId=id1&interactionId=id2)."
                },
                {
                  "disabled": false,
                  "key": "interactionId",
                  "value": "<string>",
                  "description": "(Required) One or more interaction IDs. Repeat the parameter for batch retrieval (e.g. ?interactionId=id1&interactionId=id2)."
                }
