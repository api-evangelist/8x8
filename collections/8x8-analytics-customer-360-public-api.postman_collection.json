      "id": "52cb1475-59e0-4996-a353-6c1bbd889839",
      "name": "interactions-insight",
      "description": {
        "content": "Retrieve interaction insights for a customer",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "19cce240-8519-4e99-bba5-400d7442abab",
          "name": "Get interaction insights",
          "request": {
            "name": "Get interaction insights",
            "description": {
              "content": "Retrieves interaction insights for a tenant, including interactions list and speech analytics.\n\nSupports four search strategies:\n- `contactId` + `crmId` (both required)\n- `accountId` (crmId optional)\n- `email` (crmId must not be provided)\n- `phoneNumber` (crmId must not be provided)\n\nIf `startTime` and `endTime` are omitted, a default time window is applied (1 year).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "public",
                "tenants",
                ":tenantId",
                "interactions-insight"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "contactId",
                  "value": "<string>",
                  "description": "Contact ID. Requires `crmId` when provided."
                },
                {
                  "disabled": false,
                  "key": "accountId",
                  "value": "<string>",
                  "description": "Account ID. `crmId` is optional when provided."
                },
                {
                  "disabled": false,
                  "key": "email",
                  "value": "<string>",
                  "description": "Email address. `crmId` must not be provided."
                },
                {
                  "disabled": false,
                  "key": "phoneNumber",
                  "value": "<string>",
                  "description": "Phone number in E.164 format. `crmId` must not be provided."
                },
                {
                  "disabled": false,
                  "key": "crmId",
                  "value": "<string>",
                  "description": "CRM identifier. Required with `contactId`, optional with `accountId`, forbidden with `email`/`phoneNumber`. Only the native CRM is supported."
                },
                {
                  "disabled": false,
                  "key": "startTime",
                  "value": "<dateTime>",
                  "description": "Start of the time range in ISO-8601 format with timezone offset. Defaults to 1 year before `endTime`."
                },
                {
                  "disabled": false,
                  "key": "endTime",
                  "value": "<dateTime>",
                  "description": "End of the time range in ISO-8601 format with timezone offset. Defaults to now."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "tenantId",
                  "description": "(Required) The tenant identifier. Must belong to the authenticated customer."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "x-api-key"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
            }
          },
