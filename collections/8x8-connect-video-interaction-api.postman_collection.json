      "item": [
        {
          "id": "11183d45-2e5f-4c3b-bf49-46635d9243e0",
          "name": "Token creation",
          "request": {
            "name": "Token creation",
            "description": {
              "content": "This API endpoint allows the creation of a bearer token. The API endpoint can also be used to create a new room, once a room is created, participants can join it, creating a conference. Once a room is created, the validity period is 15 minutes.  More example on this API usages can be found [here](/connect/docs/token-example-creation).\n### Authentication:\n- 8x8 Video Interaction API utilizes an 8x8 API Key for authentication.\n\t- You can create a API key directly from the Connect Portal. The process to create an API key is documented [here](/connect/docs/authentication) and a direct link to the API Keys page can be found [here](https://connect.8x8.com/messaging/api-keys).\n\t- You need to include the following header in your requests: Authorization: Bearer {API key}\n- NB: (replace the {API key} placeholder with your API key from Connect)",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "tokens"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "*/*"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"create_room\": \"<boolean>\",\n  \"phone_number\": \"<string>\",\n  \"call_reference\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "cbb5814b-f723-4b9a-bd52-453afe4d0193",
              "name": "Here is an example of successful response: ",
              "originalRequest": {
                "url": {
                  "path": [
                    "api",
                    "v1",
                    "tokens"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": []
                },
                "header": [
                  {
                    "disabled": false,
                    "description": "(Required) ",
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "disabled": false,
                    "description": "(Required) ",
                    "key": "authorization",
                    "value": "Bearer {YourApiKey}"
                  },
                  {
                    "key": "Accept",
                    "value": "*/*"
                  }
                ],
                "method": "POST",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"create_room\": true,\n  \"phone_number\": \"+6512345678\",\n  \"call_reference\": \"123abcde\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"auth_token\": \"[...]E5B87qPWXyNNDHBx_LftaHarc\"\n}",
              "cookie": [],
              "_postman_previewlanguage": "json"
            }
          ],
          "event": [],
