          "id": "3a81858d-2a1b-4444-8a8e-01a87a86e081",
          "name": "Call Logs",
          "request": {
            "name": "Call Logs",
            "description": {
              "content": "This API endpoint allows to retrieve information related to past calls. You need to use the Token API first to create an Authorization Token. You can to list the calls during a time period or with a specific Call_Reference or Phone_Number. \n\nExample 1: \n```\ncurl -X POST https://video-agent.8x8.com//api/v1/call-logs \\\n-H \"Content-Type: application/json\" \\\n-H x-token: YourAuthToken' \\\n```\n\nExample 2:\n```\ncurl -X POST\nhttps://video-agent.8x8.com/api/v1/call-logs?from=yyyy-mm-dd&to=yyyy-mm-dd&q=12345&cursor=5757 \\\n-H \"Content-Type: application/json\" \\\n-H x-token: YourAuthToken' \\\n```\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "call-logs"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "from",
                  "value": " yyyy-mm-dd"
                },
                {
                  "disabled": false,
                  "key": "to",
                  "value": " yyyy-mm-dd"
                },
                {
                  "disabled": false,
                  "key": "q",
                  "value": "<string>"
                },
                {
                  "disabled": false,
                  "key": "cursor",
                  "value": "<string>"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) ",
                "key": "x-token",
                "value": "{YourAuthToken}"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "5dc930e5-a9e2-4d52-95c9-accb15bcb3e0",
              "originalRequest": {
                "url": {
                  "path": [
